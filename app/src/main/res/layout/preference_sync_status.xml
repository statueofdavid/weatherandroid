<?xml version="1.0" encoding="utf-8"?>
<!--
  This layout is used by the custom preference in your settings screen.
  The root LinearLayout has an ID so we can easily find it in your
  SettingsFragment and toggle its visibility.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/syncStatusContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:visibility="gone">

    <ProgressBar
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Syncing latest station data..."
        android:textAppearance="?android:attr/textAppearanceListItemSecondary" />

</LinearLayout>