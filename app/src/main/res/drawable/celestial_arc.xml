<?xml version="1.0" encoding="utf-8"?>
<!--
  This drawable uses a layer-list to create a complete celestial path visual.
  Item 1: The full oval path for the sun and moon.
  Item 2: The dashed horizon line, which is centered vertically to bisect the oval.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The full oval path -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="?android:attr/textColorSecondary" />
        </shape>
    </item>

    <!-- The dashed horizon line, centered vertically -->
    <item android:gravity="center_vertical">
        <shape android:shape="line">
            <stroke
                android:width="2dp"
                android:color="?android:attr/textColorSecondary"
                android:dashWidth="8dp"
                android:dashGap="8dp" />
        </shape>
    </item>

</layer-list>